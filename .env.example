# MangaCMS Environment Variables Example

# Database (PostgreSQL)
# Leave empty to automatically use zero-setup local embedded PostgreSQL (PGlite)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mangacms?schema=public"

# Application Secrets
APP_SECRET="your-32-character-app-secret-here"
JWT_SECRET="your-jwt-signing-secret-here"

# Storage Driver (local | r2 | supabase)
# Set to "local" for local disk staging & media storage under ./storage/
# Set to "r2" or "supabase" to stream directly to Cloudflare R2 or Supabase S3
STORAGE_DRIVER="local"

# S3 Compatible Storage Configuration (Used when STORAGE_DRIVER is "r2" or "supabase")
S3_REGION="auto"
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_BUCKET="manga-assets"
S3_ACCESS_KEY_ID="your-s3-access-key"
S3_SECRET_ACCESS_KEY="your-s3-secret-key"
S3_PUBLIC_BASE_URL="https://cdn.yourmangasite.com"

# SSRF Network Security (true only in sandboxed test environments)
ALLOW_PRIVATE_NETWORK="false"
